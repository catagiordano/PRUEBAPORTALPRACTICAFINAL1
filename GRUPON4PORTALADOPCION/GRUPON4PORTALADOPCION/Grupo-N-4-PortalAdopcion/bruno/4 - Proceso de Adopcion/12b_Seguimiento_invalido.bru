meta {
  name: 12b Seguimiento inválido - campos obligatorios
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/solicitudes/{{solicitudPruebaId}}/seguimientos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "animo": "",
    "alimentacion": "",
    "tareas": "",
    "medicacion": "",
    "limpieza": "",
    "alerta": false
  }
}

tests {
  test("400 - informa que faltan datos del seguimiento", function() {
    expect(res.status).to.equal(400);
    expect(res.body.title).to.equal("Datos inválidos");
  });
  test("indica qué dato falta en cada campo", function() {
    expect(res.body.errors.animo[0]).to.equal("Ingresá el ánimo.");
    expect(res.body.errors.alimentacion[0]).to.equal("Ingresá la alimentación.");
    expect(res.body.errors.tareas[0]).to.equal("Ingresá las tareas.");
    expect(res.body.errors.medicacion[0]).to.equal("Ingresá la medicación.");
    expect(res.body.errors.limpieza[0]).to.equal("Ingresá la limpieza.");
  });
}
