meta {
  name: 06b Registro inválido (DNI con letras)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/registro
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Registro inválido",
    "email": "invalidodemo@example.com",
    "dni": "12AB34",
    "password": "ClavePrueba2026!",
    "telefono": "abc123",
    "direccion": "Calle de ejemplo",
    "edad": 25,
    "estadoCivil": "Soltero/a",
    "datosLaborales": "Estudiante"
  }
}

tests {
  test("400 - rechaza un DNI con letras", function() {
    expect(res.status).to.equal(400);
    expect(res.body.title).to.equal("Datos inválidos");
  });
  test("el mensaje explica cómo corregir el DNI", function() {
    expect(res.body.errors.dni[0]).to.contain("Solo se permiten dígitos");
  });
}

